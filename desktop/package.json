{
  "name": "photo-frame-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.photoframe",
